<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <script>
      function sendMove(direction){
        google.script.run.handleMove(direction);
      }

      let restarting  = false;
      function restartGame() {
        if(!restarting) {
          restarting = true;
          google.script.run.restartGame();
        }
        let restarting = false;
        function restartGame(){
          if(!restarting){
            restarting = true;
            google.scripts.run.restartGame();

            lastScore = 0;
            scoreElement.innerHTML = "Score:0";
            scoreElement.classList.remove("increased");

              setTimeout(function(){
                restart = false;
              },3000);
          }
        }
      }
    document.addEventListener('keyup',function(event){
      if (event.keyCode == 37) {
        sendMove('left');
      } else if (event.keyCode == 39){
        sendMove('right');
      } else if (event.keyCode == 40){
        sendMove('down');
      } else if (event.keycodde == 38){
        sendMove('rotate');
      }
    });
    </script>
  </head>
  <body>
    <div class = "details">
      <span id="score">Score: 0</span>
    </div>
    <div class ="controls">
      <button onclick = "sendMove('rotate')">Rotate</button>  
      <div>
        <button onclick = "sendMove('left')">Move Left</button>
        <button onclick = "sendMove('down')">Move Down</button>
        <button onclick="sendMove('right')">Move Right</button>
      </div>
      <button onclick="restartGame()">Restart Game </button>
    </div>
    <script>
      let lastScore = 0;
      let lastTimeout = null;
      let scoreElement = document.getElementById("score");
      window.setInterval(function(){
        google.script.run.withSuccessHandler(function(score){
          if(score!== lastScore){
            scoreElement.innerHTML = "Score: "+score;
            scoreElement.classList.add("increased");
            if (score>lastScore){
              if (lastTimeout) clearTimeout(lastTimeout);
              lastTimeout = setTimeout(function(){
                scoreElement.classList.remove("increased");
              }, 1000);
            }
            lastScore=score;
          }
        }).getScore();
      },1000);
    </script>
    <style>
      .details,
      .controls{
        display:flex;
        flex-direction:column;
        align-items:center;
      }
      #score{
        align-self:center;
        margin-bottom: 100px;
        margin-top: 100px;
        font-size: 30px;
        font-family: sans-serif;
        font-weight: bold;
        text-transform: uppercase;
        transition: all 300ms linear;
      }
      #score.increased{
        color: #00b700;
        font-weight:bold;
      
      }
      .controls>*{
        margin-bottom:20px;
      }
      .controls button{
        width:180px;
      }
      .controls div{
        display:flex;
        justify-content: space-around;
        width:100%;
      }
      .description{
        font-family: comic-relief;
        font-size: 12px;
        margin-top: 50px;
      }
    </style>
  </body>
</html>

