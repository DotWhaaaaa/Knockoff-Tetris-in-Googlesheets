const COLORS = {
  1:'#3B82F6',
  2:'#E11D48',
  3:'#10B981',
  4:'#8B5CF6', 
  5:'#F59E0B',
  6:'#EC4899',
  7:'#14B8A6'
};

const BG_COLOR = '#EEEEEE';

const INTERVAL = 500;

const ROWS = 20;

const COLS = 10;

const CELL_SIZE = 30;

const PIECES = [
  [[1,1,1,1]], //straight
  [[2,2],[2,2]],//box
  [[0,3,0],[3,3,3]],//T shaped
  [[4,0,0],[4,4,4]],//L shaped
  [[0,0,5],[5,5,5]],//j shaped
  [[6,6,0],[0,6,6]],//S shaped
  [[0,7,7],[7,7,0]],//z shaped
];

const MOVES = {
  left:   () => [currentPiece, pieceRow, pieceCol - 1],
  right:  () => [currentPiece, pieceRow, pieceCol + 1],
  down:   () => [currentPiece, pieceRow + 1, pieceCol],
  rotate: () => [rotatePiece(currentPiece), pieceRow, pieceCol]
};

const props = PropertiesService.getScriptProperties();

let board = [];

let currentPiece = null;

let currentPieceIndex = 0;

let pieceRow = 0;

let pieceCol = 0;

let score = 0;

let finished = false;

function startGame() {
  
  finished = false;
  score = 0;

  initializeBoard();
  resetValues();
  showSidebar();
  spawnPiece();

  while (!finished && props.getProperty('restart') !== 'true'){
    const start = Date.now();
    gameTick();
    const remaining = INTERVAL-(Date.now()-start);
    if(remaining>0)waiting(remaining);
  }

}

function initializeBoard() {
  
  board = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
 
  const sheet = SpreadsheetApp.getActiveSheet();
  sheet.getRange(1,1,ROWS,COLS).setBackground(BG_COLOR).clearContent();
  sheet.setColumnWidths(1,COLS,CELL_SIZE);
  sheet.setRowHeights(1,ROWS,CELL_SIZE);
}


function spawnPiece() {
  currentPieceIndex = Math.floor(Math.random() * PIECES.length);
  
  currentPiece = PIECES[currentPieceIndex];
  
  pieceRow = 0;
  
  pieceCol = Math.floor((COLS - currentPiece[0].length) / 2);
  
  if (!isValidMove(currentPiece, pieceRow, pieceCol)) {
  
    SpreadsheetApp.getActiveSpreadsheet().toast('Game Over!', 'Tetris');
    finished = true;
    return;
  }
  drawPiece(currentPiece, pieceRow, pieceCol);
}

function drawPiece(piece, row, col) {
  
  paintPiece(piece, row, col, COLORS[currentPieceIndex + 1]);
}

function clearPiece(piece, row, col) {
  
  paintPiece(piece, row, col, BG_COLOR);
}

function isValidMove(piece, row, col) {
  
  return piece.every((r, i) => r.every((cell, j) => {
  
    const x = row + i;
  
    const y = col + j;
  
    return cell === 0 ||(x >= 0 && x < ROWS && y >= 0 && y < COLS && board[x][y] === 0);
  }));
}

function gameTick() {
  
  const queue = JSON.parse(props.getProperty('moveQueue')||'[]');
  props.setProperty('moveQueue','[]');

  clearPiece(currentPiece, pieceRow, pieceCol);

  queue.forEach(move => {
    
    const [piece,row,col] = MOVES[move]?.()??[];
  
    if (piece && isValidMove(piece,row,col)){
      currentPiece=piece;
      pieceRow=row;
      pieceCol=col;
    }
  });

  if (isValidMove(currentPiece, pieceRow + 1, pieceCol)) {
    pieceRow++;
    drawPiece(currentPiece, pieceRow, pieceCol);
  
  } else {
    lockPiece();
    clearLines();
    drawBoard();
    spawnPiece();
  }
}

function lockPiece() {

  currentPiece.forEach((r,i)=>r.forEach((cell,j)=>{
    
    if(cell)board[pieceRow+i][pieceCol+j]=currentPieceIndex+1;
  }));
}

function clearLines() {
  
  let cleared = 0;
  
  for (let r = ROWS - 1; r >= 0; r--) {
  
    if (board[r].every(cell => cell > 0)) {
  
      board.splice(r, 1);
      board.unshift(Array(COLS).fill(0));
      r++;
      cleared++;
    }
  }

  if (cleared>0) {
    score+=cleared*100;
    props.setProperty('score',String(score)); 
  }
}

function drawBoard() {
  
  const colors = board.map(row=>row.map(v=>(v>0? COLORS[v]:BG_COLOR)));
  
  SpreadsheetApp.getActiveSheet().getRange(1,1,ROWS,COLS).setBackgrounds(colors);
}

function handleMove(direction) {

  const queue = JSON.parse(props.getProperty('moveQueue') || '[]');
  queue.push(direction);
  
  props.setProperty('moveQueue', JSON.stringify(queue));
}

function rotatePiece(piece) {
  
  return piece[0].map((_, index) => piece.map(row => row[index]).reverse());
}

function onOpen() {
  
  SpreadsheetApp.getUi().createMenu('Tetris')
    .addItem('Start Game', 'startGame')
    .addToUi();
}

function resetValues() {
  
  props.setProperties({
    score: String(score),
    moveQueue:'[]',
    restart:'false'
  });
}

function getScore() {
  
  return parseInt(props.getProperty('score'),10);
}

function restartGame() {
  
  props.setProperty('restart', 'true');
  waiting(2000);
  
  startGame();
}

function showSidebar() {
  
  const html = HtmlService.createHtmlOutputFromFile('Sidebar')
    .setTitle('Tetris Controls')
    .setWidth(300);
  
  SpreadsheetApp.getUi().showSidebar(html);
}

function paintPiece(piece,row,col,color){
  
  const sheet = SpreadsheetApp.getActiveSheet();
  
  piece.forEach((r,i)=>r.forEach((cell,j)=>{
    if (cell)sheet.getRange(row+i+1,col+j+1).setBackground(color);
  }));
}

function waiting(msec) {
 
  SpreadsheetApp.flush();
 
  Utilities.sleep(msec);
}
