const COLORS = {
  1:'#3B82F6',
  2:'#E11D48',
  3:'#10B981',
  4:'#8B5CF6', 
  5:'#F59E0B',
  6:'#EC4899',
  7:'#14B8A6'
};
 
const BG_PALLETTE= [
  '#FF5F00','#7B2CFF','#4deeea','#001eff','#f000ff','#ffe700','#74ee15','#39FF14','#FE019A'
];
 
let BGINDEX = 0;
 
let BG_COLOR = BG_PALLETTE[0];
 
const INTERVAL = 500;
 
const TICK = 100;
 
const BG_INTERVAL = 2000;
 
const ROWS = 20;
 
const COLS = 10;
 
const CELL_SIZE = 30;
 
const PIECES = [
  [[1,1,1,1]],
  [[2,2],[2,2]],
  [[0,3,0],[3,3,3]],
  [[4,0,0],[4,4,4]],
  [[0,0,5],[5,5,5]],
  [[6,6,0],[0,6,6]],
  [[0,7,7],[7,7,0]],
];
 
const MOVES = {
  left:   () => [currentPiece, pieceRow, pieceCol - 1],
  right:  () => [currentPiece, pieceRow, pieceCol + 1],
  down:   () => [currentPiece, pieceRow + 1, pieceCol],
  rotate: () => [rotatePiece(currentPiece), pieceRow, pieceCol]
};
 
const props = PropertiesService.getScriptProperties();
 
let board = [];
 
let currentPiece = null;
 
let currentPieceIndex = 0;
 
let pieceRow = 0;
 
let pieceCol = 0;
 
let score = 0;
 
let finished = false;
 
let lastDrop = 0;
 
let lastBg = 0;
 
let sheet = null;
 
let shown = null;
 
let restartRequested = false;
 
function startGame(openSidebar) {
  
  finished = false;
  score = 0;
 
  initializeBoard();
  resetValues();
  restartRequested = false;
  if (openSidebar !== false) showSidebar();
  spawnPiece();
 
  lastDrop = Date.now();
  lastBg = Date.now();
 
  while (!finished && !restartRequested){
    const start = Date.now();
    gameTick();
    const remaining = TICK-(Date.now()-start);
    if(remaining>0)waiting(remaining);
  }
 
}
 
function initializeBoard() {
  
  board = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
  shown = Array.from({ length: ROWS }, () => Array(COLS).fill(BG_COLOR));
 
  sheet = SpreadsheetApp.getActiveSheet();
  sheet.getRange(1,1,ROWS,COLS).setBackground(BG_COLOR).clearContent();
  sheet.setColumnWidths(1,COLS,CELL_SIZE);
  sheet.setRowHeights(1,ROWS,CELL_SIZE);
}
 
 
function spawnPiece() {
  currentPieceIndex = Math.floor(Math.random() * PIECES.length);
  
  currentPiece = PIECES[currentPieceIndex];
  
  pieceRow = 0;
  
  pieceCol = Math.floor((COLS - currentPiece[0].length) / 2);
  
  if (!isValidMove(currentPiece, pieceRow, pieceCol)) {
  
    SpreadsheetApp.getActiveSpreadsheet().toast('Game Over!', 'Tetris');
    finished = true;
    return;
  }
  render();
}
 
function render() {
  const colors = board.map(row => row.map(v => (v > 0 ? COLORS[v] : BG_COLOR)));
 
  if (!finished && currentPiece) {
    currentPiece.forEach((r, i) => r.forEach((cell, j) => {
      if (cell) colors[pieceRow + i][pieceCol + j] = COLORS[currentPieceIndex + 1];
    }));
  }
 
  let r0 = ROWS, r1 = -1, c0 = COLS, c1 = -1;
 
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      if (colors[r][c] !== shown[r][c]) {
        if (r < r0) r0 = r;
        if (r > r1) r1 = r;
        if (c < c0) c0 = c;
        if (c > c1) c1 = c;
      }
    }
  }
 
  if (r1 < 0) return;
 
  const part = colors.slice(r0, r1 + 1).map(row => row.slice(c0, c1 + 1));
 
  sheet.getRange(r0 + 1, c0 + 1, r1 - r0 + 1, c1 - c0 + 1).setBackgrounds(part);
 
  shown = colors;
}
 
function isValidMove(piece, row, col) {
  
  return piece.every((r, i) => r.every((cell, j) => {
  
    const x = row + i;
  
    const y = col + j;
  
    return cell === 0 ||(x >= 0 && x < ROWS && y >= 0 && y < COLS && board[x][y] === 0);
  }));
}
 
function takeMoves() {
 
  const all = props.getProperties();
  restartRequested = all.restart === 'true';
 
  const peek = JSON.parse(all.moveQueue || '[]');
  if (!peek.length) return peek;
 
  const lock = LockService.getScriptLock();
  lock.waitLock(1000);
 
  try {
    const queue = JSON.parse(props.getProperty('moveQueue')||'[]');
    props.setProperty('moveQueue','[]');
    return queue;
  } finally {
    lock.releaseLock();
  }
}
 
function gameTick() {
 
  const queue = takeMoves();
  const dropDue = Date.now()-lastDrop>=INTERVAL;
  const bgDue = Date.now()-lastBg>=BG_INTERVAL;
 
  if (!queue.length && !dropDue && !bgDue) return;
 
  if (bgDue) {
    lastBg = Date.now();
    BGINDEX = (BGINDEX+1)% BG_PALLETTE.length;
    BG_COLOR = BG_PALLETTE[BGINDEX];
  }
 
  queue.forEach(move => {
    
    const [piece,row,col] = MOVES[move]?.()??[];
  
    if (piece && isValidMove(piece,row,col)){
      currentPiece=piece;
      pieceRow=row;
      pieceCol=col;
    }
  });
 
  if (dropDue) {
    lastDrop = Date.now();
 
    if (isValidMove(currentPiece, pieceRow + 1, pieceCol)) {
      pieceRow++;
  
    } else {
      lockPiece();
      clearLines();
      spawnPiece();
      render();
      return;
    }
  }
 
  render();
 
}
 
function lockPiece() {
 
  currentPiece.forEach((r,i)=>r.forEach((cell,j)=>{
    
    if(cell)board[pieceRow+i][pieceCol+j]=currentPieceIndex+1;
  }));
}
 
function clearLines() {
  
  let cleared = 0;
  
  for (let r = ROWS - 1; r >= 0; r--) {
  
    if (board[r].every(cell => cell > 0)) {
  
      board.splice(r, 1);
      board.unshift(Array(COLS).fill(0));
      r++;
      cleared++;
    }
  }
 
  if (cleared>0) {
    score+=cleared*100;
    props.setProperty('score',String(score)); 
  }
}
 
function handleMove(direction) {
 
  const lock = LockService.getScriptLock();
  lock.waitLock(1000);
 
  try {
    const queue = JSON.parse(props.getProperty('moveQueue') || '[]');
    queue.push(direction);
  
    props.setProperty('moveQueue', JSON.stringify(queue));
  } finally {
    lock.releaseLock();
  }
}
 
function rotatePiece(piece) {
  
  return piece[0].map((_, index) => piece.map(row => row[index]).reverse());
}
 
function onOpen() {
  
  SpreadsheetApp.getUi().createMenu('Tetris')
    .addItem('Start Game', 'startGame')
    .addToUi();
}
 
function resetValues() {
  
  props.setProperties({
    score: String(score),
    moveQueue:'[]',
    restart:'false'
  });
}
 
function getScore() {
  
  return parseInt(props.getProperty('score'),10);
}
 
function restartGame() {
  
  props.setProperty('restart', 'true');
  waiting(2000);
  
  startGame(false);
}
 
function showSidebar() {
  
  const html = HtmlService.createHtmlOutputFromFile('Sidebar')
    .setTitle('Tetris Controls')
    .setWidth(300);
  
  SpreadsheetApp.getUi().showSidebar(html);
}
 
function waiting(msec) {
 
  SpreadsheetApp.flush();
 
  Utilities.sleep(msec);
}
